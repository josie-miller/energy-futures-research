"""Rebuild model-ready hourly capacity-factor profiles from the raw Open-Meteo downloads in ocean_data/.
Sources: ERA5 (wind_speed_100m, shortwave_radiation), ERA5-Ocean (wave_height, wave_period),
Mercator/SMOC ocean_current_velocity incl. tides (km/h, 2022+), marine-API sea_surface_temperature (Hawaii, 2022+).
Calibrations (assumptions, see OCEAN_FIRST_PITCH.md): floating wind -> 54% CF (Hywind Scotland measured);
onshore wind -> 32% (Scotland), 28% (Hawaii); wave converters rated for 30% CF; tidal turbine rated speed set
for 35% CF (30%/40% sensitivities); OTEC output ~ (dT/dT_mean)^2, cold water 4.5 C, availability 0.92."""
import numpy as np, pandas as pd
from scipy.optimize import brentq
D="ocean_data/"; O="ocean_model/"
L=lambda k: pd.read_csv(f"{D}{k}.csv.gz",index_col=0,parse_dates=True)
def wind_cf(v100,hub=150,alpha=0.11,vci=3.0,vr=10.59,vco=25.0,loss=0.12):
    v=v100*(hub/100)**alpha; p=np.clip((v**3-vci**3)/(vr**3-vci**3),0,1); p[(v<vci)|(v>vco)]=0; return p*(1-loss)
def cal_wind(v100,target,**kw):
    k=brentq(lambda s: wind_cf(v100*s,**kw).mean()-target,0.5,1.5); return wind_cf(v100*k,**kw)
solar_cf=lambda ghi: np.clip(ghi/1000*0.86,0,1)
def wave_cf(w,target=0.30,avail=0.92,hs_surv=8.0):
    hs=w.wave_height.values; fl=0.49*hs**2*w.wave_period.values   # deep-water flux, kW/m (Te ~ ERA5 mean period)
    q=brentq(lambda r: np.nanmean(np.where(hs>hs_surv,0,np.clip(fl/r,0,1))*avail)-target,1,500)
    return np.nan_to_num(np.where(hs>hs_surv,0,np.clip(fl/q,0,1))*avail)
def tidal_cf(v,vr,vci=1.0,avail=0.95):
    p=np.clip((v**3-vci**3)/(vr**3-vci**3),0,1); p[v<vci]=0; return p*avail
# Scotland
so,sn,ss,sw=L("sco_offwind"),L("sco_onwind"),L("sco_solar"),L("sco_wave")
sco=pd.DataFrame(index=so.index)
sco['offwind_floating']=cal_wind(so.wind_speed_100m.values,0.54)
sco['onwind']=cal_wind(sn.wind_speed_100m.values,0.32,hub=110,vr=12.0)
sco['solar']=solar_cf(ss.shortwave_radiation.values)
sco['wave']=wave_cf(sw)
c=L("sco_current")['ocean_current_velocity']
v=(c.loc["2022":"2024"].interpolate(limit=6).bfill().ffill()/3.6)   # km/h -> m/s
vr={t:brentq(lambda x: tidal_cf(v.values,x).mean()-t,1.2,3.5) for t in (0.30,0.35,0.40)}
full=sco.loc["2022":"2024"].copy()
for t,name in ((0.35,"scotland"),(0.30,"scotland_tcf30"),(0.40,"scotland_tcf40")):
    p=full.copy(); p['tidal']=tidal_cf(v.reindex(p.index).fillna(0).values,vr[t]); p.to_csv(f"{O}profiles_{name}.csv")
s10=sco.loc["2010"].copy(); s10['tidal']=tidal_cf(v.reindex(full.loc["2023"].index).fillna(0).values,vr[0.35])[:len(s10)]
s10.to_csv(f"{O}profiles_scotland_2010.csv")   # 2010 wind-drought weather, 2023 tidal timing (tides independent of weather)
# Hawaii
ho,hn,hs_,hw=L("haw_offwind"),L("haw_onwind"),L("haw_solar"),L("haw_wave"); sst=L("haw_sst")['sea_surface_temperature']
haw=pd.DataFrame(index=ho.index)
haw['offwind_floating']=wind_cf(ho.wind_speed_100m.values)
haw['onwind']=cal_wind(hn.wind_speed_100m.values,0.28,hub=110,vr=12.0)
haw['solar']=solar_cf(hs_.shortwave_radiation.values)
haw['wave']=wave_cf(hw)
clim=sst.groupby(sst.index.month).mean(); sf=sst.copy(); m=sf.isna(); sf[m]=clim.reindex(sf.index[m].month).values
s_all=pd.Series(clim.reindex(ho.index.month).values,index=ho.index); s_all.loc[sf.index]=sf.values
dT=s_all-4.5; haw['otec']=np.clip((dT/dT.mean())**2,0,1.15)*0.92
haw.loc["2022":"2024"].to_csv(f"{O}profiles_hawaii.csv")
print("rebuilt; tidal rated speeds (m/s):",{k:round(x,3) for k,x in vr.items()})
