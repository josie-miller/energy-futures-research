  "as_of": "2026-10-24",
  "sources": {
    "IPCC_AR6": {
      "url": "https://www.ipcc.ch/report/ar6/wg3/chapter/chapter-6/",
      "date": "2022",
      "basis": "Published energy-system scenarios through 2100; not a forecast for 2200. Demand, electrification and supply options vary across pathways."
    },
    "IAU_constants": {
      "url": "https://www.iau.org/static/resolutions/IAU2015_English.pdf",
      "date": "2015",
      "basis": "Resolution B3: nominal solar irradiance 1361 W/m2 and luminosity 3.828e26 W."
    },
    "NASA_solar": {
      "url": "https://earth.gsfc.nasa.gov/climate/projects/solar-irradiance/science",
      "date": "accessed 2026-10-24",
      "basis": "Solar irradiance at Earth and geometry of global-average incoming sunlight."
    },
    "NASA_Earth": {
      "url": "https://science.nasa.gov/earth/facts/",
      "date": "accessed 2026-10-24",
      "basis": "Planet size; model uses rounded mean radius 6371 km and spherical surface area."
    },
    "NASA_Mars": {
      "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/marsfact.html",
      "date": "accessed 2026-10-24",
      "basis": "Mars solar irradiance 586.2 W/m2, above the atmosphere at average orbital distance."
    },
    "NASA_thermal": {
      "url": "https://www.nasa.gov/wp-content/uploads/2021/10/7.soa_thermal_2021_0.pdf",
      "date": "2021",
      "basis": "Spacecraft reject heat radiatively; area, emissivity, temperature and surroundings matter."
    },
    "NASA_lunar_night": {
      "url": "https://ntrs.nasa.gov/api/citations/20170008159/downloads/20170008159.pdf",
      "date": "2017",
      "basis": "Illustrative 14-Earth-day lunar night, not universal polar darkness duration."
    },
    "NASA_fission": {
      "url": "https://www.nasa.gov/exploration-systems-development-mission-directorate/fission-surface-power/",
      "date": "accessed 2026-10-24",
      "basis": "40 kW-class lunar fission development reference; not an operating lunar fleet."
    },
    "NASA_2030": {
      "url": "https://www.nasa.gov/news-release/nasa-department-of-energy-to-develop-lunar-surface-reactor-by-2030/",
      "date": "2026-01-13",
      "basis": "Lunar reactor development target; not delivered capability."
    },
    "NASA_SBSP": {
      "url": "https://www.nasa.gov/organizations/otps/space-based-solar-power-report/",
      "date": "2024-01-11",
      "basis": "Concept-level assessment of solar power beamed to Earth; distinct from electricity used in space."
    },
    "NASA_ISAM": {
      "url": "https://www.nasa.gov/isam/",
      "date": "accessed 2026-10-24",
      "basis": "Servicing, assembly and manufacturing research. Does not demonstrate self-sufficient orbital industry."
    },
    "ITER_tritium": {
      "url": "https://www.iter.org/machine/supporting-systems/tritium-breeding",
      "date": "accessed 2026-10-24",
      "basis": "Blanket testing and fuel-cycle development remain prerequisites for relevant fusion routes."
    },
    "DOE_fast_reactor": {
      "url": "https://www.energy.gov/ne/articles/nuclear-101-what-fast-reactor",
      "date": "2025",
      "basis": "Fast reactors and repeated fuel recycling can extend resource use; full fuel-cycle engineering and economics remain necessary."
    },
    "DOE_electrolysis": {
      "url": "https://www.energy.gov/sites/default/files/2024-12/hydrogen-shot-water-electrolysis-technology-assessment.pdf",
      "date": "2024-12",
      "basis": "Electrolyzer performance targets; 55 kWh/kg system electricity used as a transparent present-scale budgeting assumption, not a 2100 prediction."
    },
    "IEA_desalination": {
      "url": "https://www.iea.org/commentaries/wired-for-water-how-electrification-is-transforming-desalination",
      "date": "2026",
      "basis": "Seawater reverse-osmosis electricity varies with process and boundaries. Model assumes 3 kWh/m3 and excludes inland distribution."
    },
    "Heat_research": {
      "url": "https://arxiv.org/abs/2409.06737",
      "date": "2025 journal version;2024preprint",
      "basis": "Theoretical study of persistent energy growth and waste heat; not used to assign a catastrophe date or a temperature forecast."
    },
    "Q1": {
      "url": "https://github.com/josie-miller/energy-futures-research/blob/main/question1/ANSWER.md",
      "date": "2026-10-24",
      "basis": "Project electricity-generation baseline and 2050 planning cases."
    },
    "Q3": {
      "url": "https://github.com/josie-miller/energy-futures-research/blob/main/question3/ANSWER.md",
      "date": "2026-10-24",
      "basis": "Project ocean proposal; 15% ocean in 2050. Q4 is a separate speculative extension."
    },
    "OTEC_2025": {
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12069477/",
      "date": "2025",
      "basis": "Primary coupled-model study: OTEC sustainability depends on output, duration and climate state. It does not certify a 7 TW ecological safety limit."
    },
    "OTEC_2013": {
      "url": "https://doi.org/10.1016/j.renene.2012.07.014",
      "date": "2013",
      "basis": "Early global circulation model assessment. The 7 TW result is a comparison, not a universal ecological safety threshold."
    },
    "Tidal_review": {
      "url": "https://ora.ox.ac.uk/objects/uuid%3A25b79764-64f0-47ad-9f8d-883dee27eba2",
      "date": "2025/2026 record",
      "basis": "Quasi-practical 110 TWh/year estimate from 90 sites, about 20% of 426 candidates; not a complete global resource ceiling."
    },
    "FPV_ecology": {
      "url": "https://os.copernicus.org/articles/16/195/2020/index.html",
      "date": "2020",
      "basis": "Three North Sea water-column simulations. Results for coverage and primary production are local model findings, not a global permitting rule."
    },
    "Open_ocean_wind": {
      "url": "https://www.pnas.org/doi/10.1073/pnas.1705710114",
      "date": "2017",
      "basis": "North Atlantic simulation with large kinetic-energy replenishment. The 6 W/m\u00b2 result is context-specific, not a guaranteed global farm yield."
    },
    "UNCLOS": {
      "url": "https://www.un.org/Depts/los/convention_agreements/texts/unclos/unclos_e.pdf",
      "date": "1982 convention;accessed2026-10-24",
      "basis": "Articles 56, 60 and 87 establish relevant jurisdiction, freedoms and obligations; the high seas are not a legal vacuum."
    }
  },
